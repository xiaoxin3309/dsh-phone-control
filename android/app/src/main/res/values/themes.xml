<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DshPhoneBridge" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dsh_primary</item>
        <item name="colorOnPrimary">@color/dsh_on_primary</item>
        <item name="colorPrimaryContainer">@color/dsh_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/dsh_on_primary_container</item>
        <item name="colorSecondary">@color/dsh_secondary</item>
        <item name="colorSecondaryContainer">@color/dsh_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/dsh_on_secondary_container</item>

        <item name="materialButtonStyle">@style/Widget.Dsh.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Dsh.Card</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- 主按钮：实心浅蓝，圆角 16dp -->
    <style name="Widget.Dsh.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 次级按钮：浅蓝底（tonal），用于「断开」等非破坏性动作 -->
    <style name="Widget.Dsh.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 描边按钮：用于「清除登录」「无障碍设置」等 -->
    <style name="Widget.Dsh.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 文字按钮 -->
    <style name="Widget.Dsh.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 卡片：无阴影 + 细描边，靠留白分组 -->
    <style name="Widget.Dsh.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/dsh_card_stroke</item>
    </style>

    <style name="TextAppearance.Dsh.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Dsh.Hint" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Dsh.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/dsh_primary</item>
        <item name="android:textColorHint" tools:ignore="MissingDefaultResource">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
