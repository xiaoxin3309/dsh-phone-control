{
  "name": "dsh-phone-control",
  "version": "0.1.6",
  "description": "Control an Android phone from DeepSeek Harness: read the accessibility tree, tap by text, type text, take screenshots, read and write files. Pair the companion app once — by code or by scanning a QR code.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "android",
    "phone",
    "accessibility",
    "automation",
    "remote-control"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxin3309/dsh-phone-control.git"
  },
  "homepage": "https://github.com/xiaoxin3309/dsh-phone-control#readme",
  "bugs": {
    "url": "https://github.com/xiaoxin3309/dsh-phone-control/issues"
  },
  "author": "dsh-phone-control contributors"
}
